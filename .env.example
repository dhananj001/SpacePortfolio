# Environment Variables Template
# Copy this to .env.local for local development
# Copy to .env.production for production

# Analytics (Optional - Add your analytics keys)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXX

# Contact Form (Optional - Add your form service)
# NEXT_PUBLIC_CONTACT_API_URL=https://api.example.com/contact

# Production Environment
NODE_ENV=production

# Build Info
NEXT_PUBLIC_BUILD_TIME=2026-01-13
NEXT_PUBLIC_VERSION=1.0.0