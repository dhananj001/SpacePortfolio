# Environment Variables Template for NebulaStack
# Copy this to .env.local for local development
# Copy to .env.production for production deployment

# ==========================================
# ANALYTICS & TRACKING (HIGHLY RECOMMENDED)
# ==========================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Hotjar (User Behavior Analytics)
NEXT_PUBLIC_HOTJAR_ID=XXXXXXX
NEXT_PUBLIC_HOTJAR_SV=6

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXXX

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX

# ==========================================
# SEO & VERIFICATION
# ==========================================

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXX

# Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXX

# Yandex Webmaster
NEXT_PUBLIC_YANDEX_VERIFICATION=XXXXXXXXXXXXXXXXXXXXX

# ==========================================
# CONTACT & LEAD GENERATION
# ==========================================

# Contact Form API (if using external service)
NEXT_PUBLIC_CONTACT_API_URL=https://api.nebulastack.in/contact

# Email Service (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAILGUN_API_KEY=key-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CRM Integration (HubSpot, Salesforce, etc.)
HUBSPOT_API_KEY=XXXXXXXXXXXXXXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
HUBSPOT_PORTAL_ID=XXXXXXX

# ==========================================
# SOCIAL MEDIA & BRANDING
# ==========================================

# Social Media Handles
NEXT_PUBLIC_TWITTER_HANDLE=@nebulastack_in
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/nebulastack
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/nebulastack
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/nebulastack_in

# Business Information
NEXT_PUBLIC_BUSINESS_NAME=NebulaStack
NEXT_PUBLIC_BUSINESS_PHONE=+91-XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_EMAIL=hello@nebulastack.in
NEXT_PUBLIC_BUSINESS_ADDRESS=Your Street Address, Bangalore, Karnataka 560001

# ==========================================
# PRODUCTION CONFIGURATION
# ==========================================

# Environment
NODE_ENV=production

# Build Information
NEXT_PUBLIC_BUILD_TIME=2026-01-13
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=https://nebulastack.in

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@sentry.io/XXXXXXX

# CDN Configuration (if using)
NEXT_PUBLIC_CDN_URL=https://cdn.nebulastack.in

# ==========================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# ==========================================

# Debug Mode (set to false in production)
NEXT_PUBLIC_DEBUG=false

# Local Development
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3000/api